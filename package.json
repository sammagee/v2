{
  "name": "me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings && pnpm lint:no-disables",
    "lint:no-disables": "! git grep -nE '(eslint|oxlint|react-doctor)-disable' -- '*.js' '*.cjs' '*.mjs' '*.ts' '*.tsx' '*.css'",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm run doctor",
    "prepare": "simple-git-hooks",
    "doctor": "react-doctor --yes --no-score --no-supply-chain --blocking warning"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "react-doctor": "0.9.18",
    "shadcn": "^4.22.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.34.6"
}
